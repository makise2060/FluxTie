<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:name="vector"
            android:width="960dp"
            android:height="960dp"
            android:viewportWidth="960"
            android:viewportHeight="960">
            <!-- 屋体轮廓：未选中带门洞，选中时门洞段塌缩为实心底边。
                 Compose 的 animated-vector 只可靠支持 pathData 动画
                 （fillColor colorType 动画不生效，曾导致选中态门洞镂空
                 露出异常色块），故选中态用 pathData 插值实现，与 fans 图标同机制。 -->
            <path
                android:name="body"
                android:fillColor="#000"
                android:pathData="M 480 120 L 130 420 L 200 420 L 200 850 Q 200 870 220 870 L 400 870 L 400 610 L 560 610 L 560 870 L 740 870 Q 760 870 760 850 L 760 420 L 830 420 Z"
                android:strokeWidth="1" />
        </vector>
    </aapt:attr>
    <target android:name="body">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="200"
                android:interpolator="@android:interpolator/fast_out_slow_in"
                android:propertyName="pathData"
                android:valueFrom="M 480 120 L 130 420 L 200 420 L 200 850 Q 200 870 220 870 L 400 870 L 400 610 L 560 610 L 560 870 L 740 870 Q 760 870 760 850 L 760 420 L 830 420 Z"
                android:valueTo="M 480 120 L 130 420 L 200 420 L 200 850 Q 200 870 220 870 L 400 870 L 400 870 L 400 870 L 560 870 L 740 870 Q 760 870 760 850 L 760 420 L 830 420 Z"
                android:valueType="pathType" />
        </aapt:attr>
    </target>
</animated-vector>
